# Copy to .env to configure leafFocus (Bun loads it automatically). All settings are optional.

# Model passed to `claude --model`, e.g. haiku, sonnet, opus. Unset = the claude CLI's default.
LEAFFOCUS_MODEL=

# true = full-screen mode (alternate screen, full terminal height, terminal restored on exit).
# false/unset = render inline below your shell prompt.
LEAFFOCUS_FULLSCREEN=false
